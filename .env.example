APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Telegram bot token from BotFather. Required to run the bot.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Pyrogram app credentials from https://my.telegram.org/apps.
# The scaffold initializes the client object but does not start it yet.
PYROGRAM_API_ID=
PYROGRAM_API_HASH=
PYROGRAM_SESSION_NAME=g_drive_bot
PYROGRAM_WORKDIR=sessions

# Google Drive OAuth files. credentials.json must be created in Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=data/token.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_AUTO_AUTH=false

# SQLite database file.
SQLITE_DB_PATH=data/app.sqlite3
DOWNLOADS_DIR=downloads
TEMP_DIR=tmp
