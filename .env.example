APP_ENV=production
LOG_LEVEL=INFO
LOG_FILE=/logs/app.log

# Telegram bot token from BotFather. Required.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-token

# Pyrogram user session for channel-origin downloads. Required by startup validation.
PYROGRAM_API_ID=
PYROGRAM_API_HASH=
PYROGRAM_SESSION_NAME=g_drive_bot
PYROGRAM_WORKDIR=/data/sessions
PYROGRAM_MAX_CONCURRENT_TRANSMISSIONS=4

# Google Drive OAuth files. Place credentials.json and token.json under ./data.
GOOGLE_CREDENTIALS_FILE=/data/credentials.json
GOOGLE_TOKEN_FILE=/data/token.json
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_AUTO_AUTH=false

# Persistent runtime paths inside the container.
SQLITE_DB_PATH=/data/app.sqlite3
DOWNLOADS_DIR=/downloads
TEMP_DIR=/temp

# Folder browser settings.
FOLDER_BROWSER_PAGE_SIZE=8
FOLDER_BROWSER_CACHE_TTL_SECONDS=300
FOLDER_RECENT_LIMIT=5
